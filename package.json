{
  "name": "focus-battery",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "pnpm dlx expo-doctor",
    "check": "pnpm typecheck && pnpm test && pnpm doctor",
    "web:export": "CI=1 expo export --platform web",
    "predeploy": "pnpm web:export",
    "deploy": "gh-pages -t -d dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test __tests__/**/*.test.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "56.0.12",
    "expo-status-bar": "56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-web": "^0.21.2",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "gh-pages": "^6.3.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
